rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    // Exception for the first user or email/password without verified email, 
    // wait, if I require email_verified == true, newly registered users might not be able to write to their profile!
    // Let's check if the app sends verification emails. Yes, `Login.tsx` does not enforce it on first login. So I cannot strictly require `email_verified == true` unless I want to break the app.
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['username']) && 
             data.username is string && data.username.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 20)) &&
             (!('is_verified' in data) || data.is_verified is bool) &&
             (!('is_blocked' in data) || data.is_blocked is bool) &&
             (!('credits' in data) || data.credits is number) &&
             (!('tickets' in data) || data.tickets is number) &&
             (!('plan_type' in data) || (data.plan_type is string && data.plan_type.size() <= 20)) &&
             (!('plan_expires_at' in data) || (data.plan_expires_at is string && data.plan_expires_at.size() <= 50)) &&
             (!('referral_code' in data) || (data.referral_code is string && data.referral_code.size() <= 50)) &&
             (!('referred_by' in data) || (data.referred_by is string && data.referred_by.size() <= 128)) &&
             (!('last_roulette_prize' in data) || data.last_roulette_prize is number) &&
             (!('mp_customer_id' in data) || (data.mp_customer_id is string && data.mp_customer_id.size() <= 128)) &&
             (!('automatic_payment' in data) || data.automatic_payment is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('created_at' in data) || (data.created_at is string && data.created_at.size() <= 50)) &&
             (!('last_active_at' in data) || (data.last_active_at is string && data.last_active_at.size() <= 50));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
             (!('isRead' in data) || data.isRead is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidSavedCard(data) {
      return data.keys().hasAll(['userId', 'mpCardId', 'lastFour']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.mpCardId is string && data.mpCardId.size() <= 128 &&
             data.lastFour is string && data.lastFour.size() <= 4 &&
             (!('brand' in data) || (data.brand is string && data.brand.size() <= 50)) &&
             (!('expirationMonth' in data) || data.expirationMonth is number) &&
             (!('expirationYear' in data) || data.expirationYear is number) &&
             (!('isDefault' in data) || data.isDefault is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidPromotion(data) {
      return data.keys().hasAll(['userId', 'url', 'cost', 'expiresAt']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.url is string && data.url.size() <= 1000 &&
             data.cost is number &&
             data.expiresAt is string && data.expiresAt.size() <= 50 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidInteraction(data) {
      return data.keys().hasAll(['userId', 'promotionId']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.promotionId is string && data.promotionId.size() <= 128 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['userId', 'amount', 'credits']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.amount is number &&
             data.credits is number &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('tickets' in data) || data.tickets is number) &&
             (!('item_type' in data) || (data.item_type is string && data.item_type.size() <= 50)) &&
             (!('plan_id' in data) || (data.plan_id is string && data.plan_id.size() <= 128)) &&
             (!('payment_method' in data) || (data.payment_method is string && data.payment_method.size() <= 50)) &&
             (!('verificationToken' in data) || (data.verificationToken is string && data.verificationToken.size() <= 500)) &&
             (!('delivered' in data) || data.delivered is bool) &&
             (!('deliveredAt' in data) || (data.deliveredAt is string && data.deliveredAt.size() <= 50)) &&
             (!('verifiedVia' in data) || (data.verifiedVia is string && data.verifiedVia.size() <= 100)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // Match rules
    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      // Users can only modify non-critical fields. Admins can modify everything.
      allow update: if isAuthenticated() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || 
        (isOwner(userId) && 
         // Ensure users don't escalate privileges or spoof credits/tickets
         incoming().diff(existing()).affectedKeys().hasAny(['username', 'last_active_at', 'plan_type', 'plan_expires_at']) &&
         (!incoming().diff(existing()).affectedKeys().hasAny(['role', 'is_verified', 'is_blocked', 'credits', 'tickets', 'referral_code', 'referred_by', 'mp_customer_id']))
        )
      );
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow get: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow list: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAdmin() && isValidId(notificationId) && isValidNotification(incoming());
        allow update: if isAuthenticated() && isOwner(userId) && isValidId(notificationId) && isValidNotification(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
        allow delete: if isAdmin() || isOwner(userId);
      }

      match /saved_cards/{savedCardId} {
        allow get, list: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isOwner(userId) && isValidId(savedCardId) && isValidSavedCard(incoming());
        allow update: if isAuthenticated() && isOwner(userId) && isValidId(savedCardId) && isValidSavedCard(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['isDefault']);
        allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    match /promotions/{promotionId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() && isValidId(promotionId) && isValidPromotion(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isAuthenticated() && isValidId(promotionId) && isValidPromotion(incoming()) && (isAdmin() || existing().userId == request.auth.uid);
      allow delete: if isAdmin() || (isAuthenticated() && existing().userId == request.auth.uid);
    }

    match /interactions/{interactionId} {
      allow get, list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidId(interactionId) && isValidInteraction(incoming()) && incoming().userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get, list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && isValidId(paymentId) && isValidPayment(incoming()) && incoming().userId == request.auth.uid;
      allow update: if isAdmin() && isValidId(paymentId) && isValidPayment(incoming());
      allow delete: if isAdmin();
    }

    match /login_logs/{loginLogId} {
      allow get, list: if isAdmin();
      allow create: if isAuthenticated(); // Assuming servers/functions write this mostly, but if client writes:
      allow update, delete: if isAdmin();
    }

    match /commissions/{commissionId} {
      allow get, list: if isAdmin() || (isAuthenticated() && (resource.data.referrer_id == request.auth.uid || resource.data.referred_id == request.auth.uid));
      allow create: if isAuthenticated(); // Typically servers write this, but client does via refs
      allow update, delete: if isAdmin();
    }

    match /trusted_devices/{trustedDeviceId} {
      allow get, list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /verification_codes/{verificationCodeId} {
      allow read, write: if false; // Should only be accessed by server logic
    }

    match /free_tickets_claims/{freeTicketsClaimId} {
      allow get, list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{auditLogId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }

    match /settings/{settingId} {
      allow read: if true; // Public settings
      allow write: if isAdmin();
    }

    match /support_requests/{supportRequestId} {
      allow get, list: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && existing().userId == request.auth.uid);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/support_requests/$(supportRequestId)).data.userId == request.auth.uid);
        allow create: if isAdmin() || (isAuthenticated() && incoming().senderId == request.auth.uid && get(/databases/$(database)/documents/support_requests/$(supportRequestId)).data.userId == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }
  }
}

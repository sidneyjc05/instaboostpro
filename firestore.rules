rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, write: if isSignedIn();

      match /notifications/{notificationId} {
        allow read, write: if isSignedIn();
      }

      match /saved_cards/{savedCardId} {
        allow read, write, create, update, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /promotions/{promotionId} {
      allow read: if isSignedIn();
      allow create, update, write: if isSignedIn();
    }
    
    match /interactions/{interactionId} {
      allow read, create, write: if isSignedIn();
    }
    
    match /payments/{paymentId} {
      allow read, create, write: if isSignedIn();
    }

    match /login_logs/{loginLogId} {
      allow read, create, write: if isSignedIn();
    }

    match /commissions/{commissionId} {
      allow read, write, create, update: if isSignedIn();
    }

    match /trusted_devices/{trustedDeviceId} {
      allow read, create, write: if isSignedIn();
    }

    match /verification_codes/{verificationCodeId} {
      allow read, create, write: if isSignedIn();
    }

    match /free_tickets_claims/{freeTicketsClaimId} {
      allow read, create, write: if isSignedIn();
    }

    match /audit_logs/{auditLogId} {
      allow read, create, write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read, write: if isSignedIn();
    }

    match /support_requests/{supportRequestId} {
      allow read, create, update, write: if isSignedIn();
      match /messages/{messageId} {
        allow read, create, write: if isSignedIn();
      }
    }
  }
}

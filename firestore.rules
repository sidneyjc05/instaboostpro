rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == 'sidneyjc05@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['username']) && 
             data.username is string && data.username.size() <= 100 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 150)) &&
             (!('role' in data) || data.role == null || (data.role is string && data.role.size() <= 20)) &&
             (!('is_verified' in data) || data.is_verified == null || data.is_verified is bool) &&
             (!('is_blocked' in data) || data.is_blocked == null || data.is_blocked is bool) &&
             (!('credits' in data) || data.credits == null || data.credits is number) &&
             (!('tickets' in data) || data.tickets == null || data.tickets is number) &&
             (!('plan_type' in data) || data.plan_type == null || (data.plan_type is string && data.plan_type.size() <= 20)) &&
             (!('plan_expires_at' in data) || data.plan_expires_at == null || (data.plan_expires_at is string && data.plan_expires_at.size() <= 50) || data.plan_expires_at is timestamp) &&
             (!('referral_code' in data) || data.referral_code == null || (data.referral_code is string && data.referral_code.size() <= 50)) &&
             (!('referred_by' in data) || data.referred_by == null || (data.referred_by is string && data.referred_by.size() <= 128)) &&
             (!('referral_count' in data) || data.referral_count == null || data.referral_count is number) &&
             (!('last_roulette_prize' in data) || data.last_roulette_prize == null || data.last_roulette_prize is number) &&
             (!('last_roulette_date' in data) || data.last_roulette_date == null || (data.last_roulette_date is string && data.last_roulette_date.size() <= 50)) &&
             (!('roulette_spins' in data) || data.roulette_spins == null || data.roulette_spins is number) &&
             (!('last_free_tickets_claim' in data) || data.last_free_tickets_claim == null || (data.last_free_tickets_claim is string && data.last_free_tickets_claim.size() <= 50)) &&
             (!('daily_reward_streak' in data) || data.daily_reward_streak == null || data.daily_reward_streak is number) &&
             (!('last_daily_reward_claim' in data) || data.last_daily_reward_claim == null || (data.last_daily_reward_claim is string && data.last_daily_reward_claim.size() <= 50)) &&
             (!('last_daily_claim' in data) || data.last_daily_claim == null || (data.last_daily_claim is string && data.last_daily_claim.size() <= 50)) &&
             (!('weekly_reward_plan' in data) || data.weekly_reward_plan == null || (data.weekly_reward_plan is string && data.weekly_reward_plan.size() <= 5000)) &&
             (!('weekly_reward_week_start' in data) || data.weekly_reward_week_start == null || (data.weekly_reward_week_start is string && data.weekly_reward_week_start.size() <= 50)) &&
             (!('weekly_claims' in data) || data.weekly_claims == null || data.weekly_claims is list) &&
             (!('interacted_promos' in data) || data.interacted_promos == null || data.interacted_promos is list) &&
             (!('missions_progress' in data) || data.missions_progress == null || data.missions_progress is map) &&
             (!('mp_customer_id' in data) || data.mp_customer_id == null || (data.mp_customer_id is string && data.mp_customer_id.size() <= 128)) &&
             (!('automatic_payment' in data) || data.automatic_payment == null || data.automatic_payment is bool) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp) &&
             (!('created_at' in data) || data.created_at == null || (data.created_at is string && data.created_at.size() <= 50) || data.created_at is timestamp) &&
             (!('last_active_at' in data) || data.last_active_at == null || (data.last_active_at is string && data.last_active_at.size() <= 50) || data.last_active_at is timestamp);
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['title', 'message']) &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('user_id' in data) || (data.user_id is string && data.user_id.size() <= 128)) &&
             (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
             (!('isRead' in data) || data.isRead is bool) &&
             (!('is_read' in data) || data.is_read is number || data.is_read is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('created_at' in data) || (data.created_at is string && data.created_at.size() <= 50));
    }

    function isValidSavedCard(data) {
      return data.keys().hasAll(['userId', 'mpCardId', 'lastFour']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.mpCardId is string && data.mpCardId.size() <= 128 &&
             data.lastFour is string && data.lastFour.size() <= 4 &&
             (!('brand' in data) || (data.brand is string && data.brand.size() <= 50)) &&
             (!('expirationMonth' in data) || data.expirationMonth is number) &&
             (!('expirationYear' in data) || data.expirationYear is number) &&
             (!('isDefault' in data) || data.isDefault is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('cardholderName' in data) || (data.cardholderName is string && data.cardholderName.size() <= 100)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 50)) &&
             (!('username' in data) || (data.username is string && data.username.size() <= 100));
    }

    function isValidPromotion(data) {
      return data.keys().hasAll(['url', 'cost']) &&
             data.url is string && data.url.size() <= 1000 &&
             data.cost is number &&
             (!('userId' in data) || (data.userId is string && data.userId.size() <= 128)) &&
             (!('user_id' in data) || (data.user_id is string && data.user_id.size() <= 128)) &&
             (!('username' in data) || (data.username is string && data.username.size() <= 100)) &&
             (!('plan' in data) || (data.plan is string && data.plan.size() <= 50)) &&
             (!('interactions_count' in data) || data.interactions_count is number) &&
             (!('expiresAt' in data) || (data.expiresAt is string && data.expiresAt.size() <= 50)) &&
             (!('expires_at' in data) || (data.expires_at is string && data.expires_at.size() <= 50)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50)) &&
             (!('created_at' in data) || (data.created_at is string && data.created_at.size() <= 50));
    }

    function isValidPayment(data) {
      return data.keys().hasAll(['userId', 'amount', 'credits']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.amount is number &&
             data.credits is number &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('username' in data) || (data.username is string && data.username.size() <= 100)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('cpf' in data) || (data.cpf is string && data.cpf.size() <= 50)) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('tickets' in data) || data.tickets is number) &&
             (!('itemType' in data) || (data.itemType is string && data.itemType.size() <= 50)) &&
             (!('planId' in data) || data.planId == null || (data.planId is string && data.planId.size() <= 128)) &&
             (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 50)) &&
             (!('verificationToken' in data) || (data.verificationToken is string && data.verificationToken.size() <= 500)) &&
             (!('delivered' in data) || data.delivered == null || data.delivered is bool) &&
             (!('deliveredAt' in data) || data.deliveredAt == null || (data.deliveredAt is string && data.deliveredAt.size() <= 50) || data.deliveredAt is timestamp) &&
             (!('verifiedVia' in data) || data.verifiedVia == null || (data.verifiedVia is string && data.verifiedVia.size() <= 100)) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is string && data.createdAt.size() <= 50) || data.createdAt is timestamp) &&
             (!('created_at' in data) || data.created_at == null || (data.created_at is string && data.created_at.size() <= 50) || data.created_at is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is string && data.updatedAt.size() <= 50) || data.updatedAt is timestamp) &&
             (!('updated_at' in data) || data.updated_at == null || (data.updated_at is string && data.updated_at.size() <= 50) || data.updated_at is timestamp) &&
             (!('expiresAt' in data) || data.expiresAt == null || (data.expiresAt is string && data.expiresAt.size() <= 50) || data.expiresAt is timestamp) &&
             (!('expires_at' in data) || data.expires_at == null || (data.expires_at is string && data.expires_at.size() <= 50) || data.expires_at is timestamp) &&
             (!('approvedAt' in data) || data.approvedAt == null || (data.approvedAt is string && data.approvedAt.size() <= 50) || data.approvedAt is timestamp) &&
             (!('approved_at' in data) || data.approved_at == null || (data.approved_at is string && data.approved_at.size() <= 50) || data.approved_at is timestamp) &&
             (!('cardLast4' in data) || data.cardLast4 == null || (data.cardLast4 is string && data.cardLast4.size() <= 10)) &&
             (!('cardBrand' in data) || data.cardBrand == null || (data.cardBrand is string && data.cardBrand.size() <= 50)) &&
             (!('installments' in data) || data.installments == null || data.installments is number) &&
             (!('pixCode' in data) || data.pixCode == null || (data.pixCode is string && data.pixCode.size() <= 2000)) &&
             (!('qrCodeBase64' in data) || data.qrCodeBase64 == null || (data.qrCodeBase64 is string && data.qrCodeBase64.size() <= 5000));
    }

    match /users/{userId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() && isValidId(userId) && isValidUser(incoming());
      allow update: if isAuthenticated() && isValidId(userId) && isValidUser(incoming());
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow get, list: if isAuthenticated();
        allow create: if isAuthenticated() && isValidId(notificationId) && isValidNotification(incoming());
        allow update: if isAuthenticated() && isValidId(notificationId) && isValidNotification(incoming());
        allow delete: if isAuthenticated();
      }

      match /saved_cards/{savedCardId} {
        allow get, list: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow create: if isAuthenticated() && isOwner(userId) && isValidId(savedCardId) && isValidSavedCard(incoming());
        allow update: if isAuthenticated() && isOwner(userId) && isValidId(savedCardId) && isValidSavedCard(incoming());
        allow delete: if isAuthenticated() && (isOwner(userId) || isAdmin());
      }
    }

    match /promotions/{promotionId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() && isValidId(promotionId) && isValidPromotion(incoming());
      allow update: if isAuthenticated() && isValidId(promotionId) && isValidPromotion(incoming());
      allow delete: if isAuthenticated();
    }

    match /interactions/{interactionId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated() && isValidId(paymentId) && isValidPayment(incoming()) && (isAdmin() || (incoming().status != "approved" && incoming().status != "delivered" && incoming().delivered != true));
      allow update: if isAuthenticated() && isValidId(paymentId) && isValidPayment(incoming()) && (isAdmin() || (isOwner(existing().userId) && (incoming().status == existing().status || incoming().status == "refund_requested") && incoming().delivered == existing().delivered && incoming().amount == existing().amount && incoming().credits == existing().credits));
      allow delete: if isAdmin();
    }

    match /login_logs/{loginLogId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /commissions/{commissionId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /trusted_devices/{trustedDeviceId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /verification_codes/{verificationCodeId} {
      allow read, write: if false; 
    }

    match /free_tickets_claims/{freeTicketsClaimId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{auditLogId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read, write: if isAuthenticated();
    }

    match /support_requests/{supportRequestId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }

    match /video_durations/{docId} {
      allow get, list: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}

